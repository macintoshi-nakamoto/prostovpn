# Настройки панели, сайта и приёма оплаты.
#
# Скопировать в .env и заполнить. Значений здесь нет и быть не должно:
# .env.example лежит в git, .env — нет.
#
# Проверить готовность к бою: панель на старте пишет в лог всё, что осталось
# по умолчанию и мешает выпускать её наружу.

# ─── База ─────────────────────────────────────────────────────────────────
# SQLite годится для старта и сотен пользователей. На боевом VPS:
#   PANEL_DATABASE_URL=postgresql+psycopg://prosto:пароль@localhost/prosto
PANEL_DATABASE_URL=sqlite:///./panel.db

# ─── Администратор ────────────────────────────────────────────────────────
# Первый администратор создаётся при первом запуске.
PANEL_ADMIN_LOGIN=admin
PANEL_ADMIN_PASSWORD=

# ─── Секреты ──────────────────────────────────────────────────────────────
# Сгенерировать оба:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# SECRET_KEY  — подпись служебных значений.
# SECRETS_KEY — ключ шифрования паролей клиентов. Менять его нельзя:
#               после смены все сохранённые пароли станут нечитаемыми,
#               и «показать пароль» в панели перестанет работать.
PANEL_SECRET_KEY=
PANEL_SECRETS_KEY=

PANEL_CLIENT_TOKEN_DAYS=30
PANEL_ADMIN_TOKEN_DAYS=7
PANEL_CURRENCY=RUB

# Подписка (ссылка /s/<token>). Срок скользящий: активный клиент опрашивает
# подписку и продлевает её, забытая/утёкшая ссылка сама умирает.
PANEL_SUBSCRIPTION_TOKEN_DAYS=180
# Базовый адрес подписки. Пусто — берётся PANEL_SITE_URL. На бою — отдельный
# поддомен, чтобы ссылку можно было проксировать и логировать отдельно.
PANEL_SUBSCRIPTION_URL=https://sub.prostovpn.cc

# Откуда пускаем веб-панель. В разработке Vite поднимается на 5173.
# На боевом сервере панель раздаётся тем же приложением с /admin, и список
# можно оставить пустым.
PANEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Как часто панель обходит узлы по SSH, секунд. Этим же заходом снимаются
# рукопожатия (по ним считается «онлайн») и срабатывает лимит трафика.
# 0 останавливает обход целиком, а вместе с ним — автоматическое закрытие
# доступа по исчерпанному трафику и по кончившейся подписке.
PANEL_TRAFFIC_SYNC_SECONDS=60

# Демо-данные в пустую базу. На боевом обязательно 0, иначе в базе появятся
# выдуманные люди с выдуманными платежами.
PANEL_SEED_DEMO=0
PANEL_DEBUG=0

# ─── Сайт ─────────────────────────────────────────────────────────────────
# Публичный адрес. Из него собираются ссылки возврата с платёжной формы и
# ссылки в письмах — адрес должен быть тот, по которому сайт открывают люди.
PANEL_SITE_URL=https://panel.example.com

# Каталог собранного сайта. Пусто — приложение его не раздаёт (так делают,
# когда статику отдаёт nginx).
PANEL_SITE_DIR=../site

# Каталог с установщиками приложения — тот же, что nginx отдаёт по
# /downloads/ (см. deploy/nginx.conf). Панель берёт оттуда файл, чтобы
# посчитать его размер и sha256 при публикации версии: без контрольной
# суммы приложение отказывается ставить обновление.
PANEL_DOWNLOADS_DIR=/var/www/prosto-downloads

# ─── Оплата ───────────────────────────────────────────────────────────────
# mock | yookassa | cryptocloud
#
# mock — имитация: сайт работает целиком, но деньги не приходят. Годится,
# пока договор с платёжным сервисом не подписан. Выпускать так наружу можно
# только сознательно: любой посетитель сможет «оплатить» себе подписку.
PANEL_PAYMENT_PROVIDER=mock
PANEL_MOCK_DELAY_SECONDS=2
PANEL_MOCK_SECRET=

# ЮKassa. Уведомления она не подписывает, поэтому подлинность проверяется
# адресом отправителя и повторным запросом платежа через API — для второго
# нужны эти ключи.
PANEL_YOOKASSA_SHOP_ID=
PANEL_YOOKASSA_SECRET_KEY=
# Список сетей из документации ЮKassa. Менять, только если он там изменился.
# PANEL_YOOKASSA_IP_ALLOWLIST=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,...

# CryptoCloud. Секрет обязателен: без него подпись уведомления проверить
# нечем, и панель откажется принимать такие уведомления.
PANEL_CRYPTOCLOUD_API_KEY=
PANEL_CRYPTOCLOUD_SHOP_ID=
PANEL_CRYPTOCLOUD_SECRET=

# Через сколько часов неоплаченный заказ закрывается сам.
PANEL_ORDER_TTL_HOURS=24

# ─── Письма ───────────────────────────────────────────────────────────────
# smtp | resend | console
#
# console — только пишет в лог факт отправки (без пароля). Для разработки.
#
# Отправлять напрямую с VPS без SPF, DKIM и DMARC нельзя: письмо с логином и
# паролем уедет в спам почти гарантированно. Настройка записей — в
# deploy/README.md.
PANEL_MAIL_PROVIDER=console
PANEL_MAIL_FROM=no-reply@example.com
PANEL_MAIL_FROM_NAME=Prosto
# В теме намеренно нет слова VPN: российские почтовики фильтруют такие
# письма охотнее, а внутри всё равно только логин и пароль.
PANEL_MAIL_SUBJECT=Ваш доступ к сервису Prosto

PANEL_SMTP_HOST=
PANEL_SMTP_PORT=587
PANEL_SMTP_USER=
PANEL_SMTP_PASSWORD=
PANEL_SMTP_STARTTLS=1
PANEL_SMTP_SSL=0

PANEL_RESEND_API_KEY=

# Бот для дублирования доступа в Telegram. Пусто — канал выключен.
PANEL_TELEGRAM_BOT_TOKEN=

# Как часто разгребается очередь доставки, секунд. 0 — не разгребать
# (например, когда очередь крутит отдельный процесс).
PANEL_DELIVERY_POLL_SECONDS=15
PANEL_DELIVERY_MAX_ATTEMPTS=8

# ─── Ограничение частоты ──────────────────────────────────────────────────
PANEL_LOGIN_MAX_ATTEMPTS=5
PANEL_LOGIN_WINDOW_MINUTES=15
PANEL_LOGIN_LOCK_MINUTES=15
PANEL_ORDER_MAX_PER_HOUR=10

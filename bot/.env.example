# Токен бота из @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую — им приходят обращения и оплаты
ADMIN_IDS=

# Панель: общая база аккаунтов сайта, приложения и бота.
# На сервере — http://127.0.0.1:8000, снаружи — https://prostovpn.cc
PANEL_URL=http://127.0.0.1:8000
PANEL_ADMIN_LOGIN=
PANEL_ADMIN_PASSWORD=

# Тариф новых учёток, заведённых из бота
SIGNUP_PLAN=trial

# Сколько звёзд просить за рубль цены тарифа
STARS_RATE=0.6

# Оплата картой внутри бота (необязательно): токен провайдера из @BotFather
PROVIDER_TOKEN=
CURRENCY=RUB

SITE_URL=https://prostovpn.cc
CHANNEL_URL=https://t.me/myprostovpn

# Инструкция по установке: кнопка под «Наш канал» и ссылка на экране ключа
# для iPhone — приложения под iOS нет, ключ вставляют по инструкции.
GUIDE_URL=https://prostovpn.cc/guide

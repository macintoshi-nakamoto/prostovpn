# URLs/public keys below are compiled into the client and are not secrets.
# Leave managed-service endpoints empty until Nexa owns that infrastructure.
PROD_AGW_PUBLIC_KEY=
PROD_S3_ENDPOINT=
FALLBACK_S3_ENDPOINT=
DEV_AGW_PUBLIC_KEY=
DEV_AGW_ENDPOINT=
DEV_S3_ENDPOINT=
FREE_V2_ENDPOINT=
PREM_V1_ENDPOINT=

# Windows release signing (certificate must already be securely installed).
SIGNTOOL_SUBJECT_NAME=

# Android release signing. Store real values only in a CI secret manager.
ANDROID_RELEASE_KEYSTORE_BASE64=
ANDROID_RELEASE_KEYSTORE_KEY_ALIAS=
ANDROID_RELEASE_KEYSTORE_KEY_PASS=

# Apple delivery credentials. Never commit the private key.
APPSTORE_CONNECT_KEY_ID=
APPSTORE_CONNECT_ISSUER_ID=
APPSTORE_CONNECT_PRIVATE_KEY=

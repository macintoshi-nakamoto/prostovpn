# Правила сжатия релизной сборки.
#
# Сжатие включено ради размера и скорости холодного старта, а не ради
# обфускации: имена не переименовываем вовсе. Обфускация экономила бы ещё
# немного, но JNI-мост wg-go находит Java-классы по строковым именам, и
# каждое переименованное имя — это туннель, который не поднимется уже у
# людей, а не на сборке. Несколько сотен килобайт того не стоят.
-dontobfuscate

# Движок туннеля целиком. Нативная библиотека вызывает Java по именам
# (GoBackend и его VpnService), конфиг разбирается рефлексией полей —
# вычищать из него «неиспользуемое» нельзя.
-keep class org.amnezia.awg.** { *; }
-dontwarn org.amnezia.awg.**

# Компоненты, на которые ссылается манифест, из кода не видны.
-keep class com.prostovpn.app.App { *; }
-keep class com.prostovpn.app.MainActivity { *; }
-keep class com.prostovpn.app.VpnForegroundService { *; }

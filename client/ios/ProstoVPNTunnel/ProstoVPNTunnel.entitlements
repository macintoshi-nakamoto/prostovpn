<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- То же право, что у приложения: туннель поднимает именно расширение. -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>

	<!--
	Группа и связка ключей — те же, что у приложения. Расходись они хоть в
	одном символе, расширение не прочитает конфиг и туннель не поднимется
	без единой ошибки на экране.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.cc.prostovpn</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)cc.prostovpn.shared</string>
	</array>
</dict>
</plist>

# Скопировать в .env и поправить под себя.

# SQLite годится для старта и сотен пользователей. Для боевого VPS:
# PANEL_DATABASE_URL=postgresql+psycopg://prosto:пароль@localhost/prosto
PANEL_DATABASE_URL=sqlite:///./panel.db

# Первый администратор создаётся при первом запуске.
PANEL_ADMIN_LOGIN=admin
PANEL_ADMIN_PASSWORD=смени-меня

# Подпись cookie админки. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PANEL_SECRET_KEY=смени-меня-обязательно

# Сколько дней живёт токен приложения
PANEL_CLIENT_TOKEN_DAYS=30

# Валюта в статистике
PANEL_CURRENCY=RUB

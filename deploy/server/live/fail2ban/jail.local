# Блокировка переборщиков. Работает поверх ufw: fail2ban вставляет свои
# правила в начало INPUT, поэтому срабатывает раньше разрешающих.
[DEFAULT]
backend = systemd
# Свои адреса не баним никогда: иначе один кривой скрипт с панели отрежет
# её же от узлов.
ignoreip = 127.0.0.1/8 ::1 103.114.43.45 103.114.43.44 109.107.168.166 194.35.226.8
bantime  = 1h
findtime = 10m
maxretry = 5
# Повторные нарушители сидят дольше: 1ч, 2ч, 4ч и так далее.
bantime.increment = true
bantime.factor = 2
bantime.maxtime = 1w

[sshd]
enabled = true
port    = 22,22222
maxretry = 4
bantime  = 4h

[nginx-panel-auth]
enabled  = true
backend  = auto
port     = http,https
filter   = nginx-panel-auth
logpath  = /var/log/nginx/access.log
maxretry = 6
findtime = 10m
bantime  = 12h

[nginx-bad-request]
enabled  = true
backend  = auto
port     = http,https
filter   = nginx-bad-request
logpath  = /var/log/nginx/access.log
maxretry = 20
findtime = 5m
bantime  = 2h

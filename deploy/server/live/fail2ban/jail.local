# Блокировка переборщиков. Для sshd — поверх ufw: fail2ban вставляет свои
# правила в начало INPUT, поэтому срабатывает раньше разрешающих. Для nginx
# пакетный бан бесполезен: сайт за Cloudflare, 80/443 открыты только её
# диапазонам, и правило с настоящим адресом человека никогда не совпадает —
# там бан делает nginx (action nginx-deny, deny по адресу после real_ip).
[DEFAULT]
backend = systemd
# Свои адреса не баним никогда: иначе один кривой скрипт с панели отрежет
# её же от узлов. Диапазоны Cloudflare (на 06.09.2026) — на случай сбоя
# real_ip: тогда в журнале окажется край Cloudflare, и его бан в nginx
# отрезал бы сайт от всех, кто идёт через этот край.
ignoreip = 127.0.0.1/8 ::1 103.114.43.45 103.114.43.44 109.107.168.166 194.35.226.8
    173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18
    108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17
    162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
    2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32
    2a06:98c0::/29 2c0f:f248::/32
bantime  = 1h
findtime = 10m
maxretry = 5
# Повторные нарушители сидят дольше: 1ч, 2ч, 4ч и так далее.
bantime.increment = true
bantime.factor = 2
bantime.maxtime = 1w

[sshd]
enabled = true
port    = 22,22222
maxretry = 4
bantime  = 4h

[nginx-panel-auth]
enabled  = true
backend  = auto
banaction = nginx-deny
filter   = nginx-panel-auth
logpath  = /var/log/nginx/access.log
maxretry = 6
findtime = 10m
bantime  = 12h

[nginx-bad-request]
enabled  = true
backend  = auto
banaction = nginx-deny
filter   = nginx-bad-request
logpath  = /var/log/nginx/access.log
maxretry = 20
findtime = 5m
bantime  = 2h

server {
    listen 80;
    listen [::]:80;
    server_name prostovpn.cc www.prostovpn.cc;

    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://prostovpn.cc$request_uri; }
}

# Заходы по IP на этот сервер. Сборки приложения, собранные на адрес
# прежнего сервера, 28.08.2026 остались без хоста — та машина отдана.
# Чинится это только обновлением приложения, здесь ловить нечего.
# Сертификат здесь по-прежнему самоподписанный — валидным он на IP быть не
# может; правильный путь для клиентов один: домен.
server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name _;

    ssl_certificate     /etc/ssl/prosto/panel.crt;
    ssl_certificate_key /etc/ssl/prosto/panel.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Запрос без нашего имени (по IP или с чужим Host) раньше уходил в панель
    # мимо всех лимитов частоты — это был обход защиты входа. Теперь молча
    # закрываем соединение: настоящие клиенты ходят только по домену.
    return 444;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    limit_conn prosto_conn 20;
    server_name prostovpn.cc www.prostovpn.cc;

    ssl_certificate     /etc/letsencrypt/live/prostovpn.cc/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/prostovpn.cc/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 2m;
    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json;
    gzip_min_length 1024;

    # Вебхуки платёжных сервисов. Отдельным блоком и без ограничения
    # частоты: провайдер имеет право повторять доставку сколько угодно, и
    # отбитый нами повтор означает оплаченный заказ без доступа.
    location /api/v1/billing/webhook/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Настоящий адрес отправителя — по нему панель сверяет вебхук со
        # списком сетей платёжного сервиса.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location = /api/v1/login {
        limit_req zone=prosto_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Вход в админку и восстановление пароля. Без этих блоков они попадали
    # под общий лимит /api/ — 120 запросов в минуту, то есть два в секунду:
    # для перебора пароля администратора этого достаточно. Здесь тот же
    # строгий пояс, что и у клиентского входа.
    location = /api/v1/login/telegram {
        limit_req zone=prosto_login burst=10 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /api/admin/login {
        limit_req zone=prosto_login burst=3 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/v1/password/forgot {
        limit_req zone=prosto_login burst=3 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/v1/password/reset {
        limit_req zone=prosto_login burst=3 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/v1/register {
        limit_req zone=prosto_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        limit_req zone=prosto_api burst=40 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Страница успеха показывает логин и пароль — кэшировать её нельзя ни
    # браузеру, ни промежуточным прокси.
    location = /success.html {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store" always;
    }

    # Установщики приложения.
    location /downloads/ {
        alias /var/www/downloads/;
        autoindex off;
        add_header Cache-Control "public, max-age=86400";
    }

    # Установщик Android. Без явного типа nginx отдаёт octet-stream, и Chrome
    # на телефоне сохраняет файл как .bin — Android в таком не видит пакет и
    # ставить отказывается. Имя в Content-Disposition — чтобы файл дошёл под
    # своим именем даже там, где тип по дороге перепишут.
    location ~* ^/downloads/(?<installer>[A-Za-z0-9._-]+\.apk)$ {
        alias /var/www/downloads/$installer;
        default_type application/vnd.android.package-archive;
        add_header Content-Disposition 'attachment; filename="$installer"';
        add_header Cache-Control "public, max-age=86400";
    }

    # Одностраничный сайт: ассеты кэшируем надолго, страницу — никогда.
    #
    # Имена бандлов содержат хеш, картинки — версию, поэтому их можно держать
    # в кэше год. А index.html ссылается на конкретные имена: закэшированный,
    # он продолжает тянуть прежние файлы, и человек видит старый сайт при
    # полностью обновлённом сервере. Ровно так и вышло с логотипом — на
    # сервере лежал новый, в браузере оставалась прежняя страница со ссылкой
    # на прежний файл.
    location ~* ^/assets/.*\.(js|css|png|jpe?g|webp|svg|ico|woff2?)$ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        add_header Cache-Control "no-cache" always;
    }
}

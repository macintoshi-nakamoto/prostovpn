server {
    listen 80;
    listen [::]:80;
    server_name sub.prostovpn.cc;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://sub.prostovpn.cc$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    limit_conn prosto_conn 20;
    server_name sub.prostovpn.cc;

    ssl_certificate     /etc/letsencrypt/live/prostovpn.cc/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/prostovpn.cc/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;

    # Токен в пути — в журнал доступа его не пишем.
    location /s/ {
        access_log off;
        limit_req zone=prosto_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # На поддомене больше ничего нет.
    location / { return 404; }
}

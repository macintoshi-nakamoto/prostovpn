# /etc/systemd/system/prosto-extra-ports.service
[Unit]
Description=Prosto VPN — дополнительные UDP-порты для AmneziaWG
After=network-online.target amnezia-awg@awg0.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/env bash /root/extra-ports.sh --restore

[Install]
WantedBy=multi-user.target

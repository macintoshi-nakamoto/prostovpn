<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.prostovpn.helper</string>

	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/com.prostovpn.helper</string>
	</array>

	<!-- Туннель живёт внутри хелпера: умрёт он — оборвётся и туннель.
	     Поэтому демон поднимается сразу и перезапускается всегда. -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>

	<key>ProcessType</key>
	<string>Interactive</string>

	<key>StandardErrorPath</key>
	<string>/var/log/prostovpn-helper.log</string>
</dict>
</plist>

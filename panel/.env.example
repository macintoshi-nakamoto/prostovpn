# Локальный запуск панели. На боевом сервере поменять пароль и секрет.

PANEL_DATABASE_URL=sqlite:///./panel.db

PANEL_ADMIN_LOGIN=admin
PANEL_ADMIN_PASSWORD=admin

# Сгенерировать свой:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PANEL_SECRET_KEY=dev-insecure-change-me

PANEL_CLIENT_TOKEN_DAYS=30
PANEL_ADMIN_TOKEN_DAYS=7
PANEL_CURRENCY=RUB

# Откуда пускаем веб-панель (Vite в разработке)
PANEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Как часто снимать счётчики трафика с серверов, минут. 0 — только вручную.
PANEL_TRAFFIC_SYNC_MINUTES=15

# Демо-данные в пустую базу. На боевом обязательно 0.
PANEL_SEED_DEMO=1

PANEL_DEBUG=0

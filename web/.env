# Бренд по умолчанию — Prosto VPN. Второй продукт собирается так:
#   vite build --mode rusvpn      (подхватывает .env.rusvpn, кладёт в dist-rusvpn)
# Значения попадают в index.html (%VITE_...%) и в src/lib/brand.js.
VITE_BRAND=prosto
VITE_BRAND_TITLE="Prosto VPN"
VITE_BRAND_DESC="Prosto VPN: подключение в одно нажатие, 60+ стран, скорость до 1 Гбит/с. Без логов и без сложных настроек. Пробный период — два дня бесплатно."
VITE_THEME_COLOR="#FA4C16"
VITE_THEME_DARK="#1a1a1c"
VITE_ICON_DIR="/assets"
